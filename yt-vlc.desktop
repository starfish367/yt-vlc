[Desktop Entry]
Version=1.0
Type=Application
Name=Xem YouTube bằng VLC
GenericName=YouTube VLC Player
Comment=Trình phát YouTube giao diện GTK3 trực tiếp trên VLC
Exec=/home/a/.local/bin/yt-vlc %U
Icon=yt-vlc
Terminal=false
Categories=AudioVideo;Player;Network;
